{
    "name": "sleepytale",
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/rust:1": {}
    },
    "appPort": "5520:5520/udp",
    "remoteUser": "vscode",
    "dockerFile": "Dockerfile",
    "context": "..",
    "mounts": [
        "source=${localEnv:HOME}/.hytale,target=/home/vscode/.hytale,type=bind,consistency=cached"
    ]
}